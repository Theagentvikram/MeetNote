{
  "name": "meetnote-desktop",
  "version": "1.0.0",
  "description": "MeetNote Desktop - AI Meeting Assistant for Mac",
  "main": "src/main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && ./node_modules/.bin/electron .",
    "dev": "unset ELECTRON_RUN_AS_NODE && NODE_ENV=development ./node_modules/.bin/electron .",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac",
    "dist": "electron-builder --publish=never",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "meeting",
    "transcription",
    "AI",
    "recording",
    "mac"
  ],
  "author": "MeetNote Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "node-record-lpcm16": "^1.0.1",
    "speaker": "^0.5.4",
    "wav": "^1.0.2",
    "whisper-node": "^1.1.1"
  },
  "build": {
    "appId": "com.meetnote.desktop",
    "productName": "MeetNote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MeetNote needs microphone access to record your voice in meetings.",
        "NSScreenCaptureUsageDescription": "MeetNote needs Screen Recording access to capture system audio from meeting apps.",
        "NSAudioCaptureUsageDescription": "MeetNote needs audio capture access to record and transcribe meetings."
      }
    },
    "dmg": {
      "title": "MeetNote Installer",
      "icon": "assets/icon.icns"
    }
  }
}
